# See the repo root .env.example for the full list across all integrations.
# Both safe to expose to the browser — the anon/publishable key is meant to
# be public; access control is enforced by Postgres RLS, not by keeping
# this key secret.
NEXT_PUBLIC_SUPABASE_URL=https://nrmdcwezgdeiwcebbdcj.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_hYWkH44wWc7Fl2vR_yhwkw_yW-Iz03U

# Server-only. Never exposed to the browser, never committed with a real
# value. Needed by the public gallery routes (/gallery/[slug],
# /embed/gallery/[id]) to verify password/expiry rules and issue signed
# URLs server-side — see docs/DECISIONS.md D-015. Get it from Supabase
# Dashboard -> Project Settings -> API -> service_role key.
SUPABASE_SERVICE_ROLE_KEY=

# Public. Used only to display the full gallery share link in the staff UI
# (falls back to a relative path if unset). Set to the deployed app's URL.
NEXT_PUBLIC_APP_URL=

# ---- Square (Phase 3 hookup — production credentials) ----
# Server-only. Never exposed to the browser, never committed with a real
# value. Get these from the Square Developer Dashboard for the Disco
# Sundays production application. Names match what's actually configured
# in apps/web/.env.local as of 2026-09-24 — see docs/DECISIONS.md D-019
# (no SQUARE_PRODUCTION_ prefix; this project has no separate sandbox
# credential set, so the plain names are canonical).
SQUARE_APPLICATION_ID=
SQUARE_ACCESS_TOKEN=
SQUARE_APPLICATION_SECRET=
SQUARE_LOCATION_ID=
# Not yet configured — only needed once a webhook subscription is
# registered with Square (a write/config action requiring explicit
# approval before it's done against the live account).
SQUARE_WEBHOOK_SIGNATURE_KEY=
