# Disco Sundays CRM — environment variables
# Copy to .env.local for local development. Never commit real values.
# NEXT_PUBLIC_* variables are exposed to the browser — nothing secret belongs there.

# ---- Supabase (required, Phase 1) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the client. Used only in API routes/server actions.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Square (Phase 3 — booking/payment sync) ----
# Server-only. Configured in apps/web/.env.local as of 2026-09-24 — see
# docs/DECISIONS.md D-019. Production only; no separate sandbox credential
# set exists for this project.
SQUARE_APPLICATION_ID=
SQUARE_ACCESS_TOKEN=
SQUARE_APPLICATION_SECRET=
SQUARE_LOCATION_ID=
SQUARE_WEBHOOK_SIGNATURE_KEY=
# Not connected until a webhook subscription is registered with Square
# (write/config action on the live account — requires explicit approval).

# ---- Shopify (Phase 5 — storefront sync) ----
# Server-only. A Shopify Dev Dashboard app ("Disco Sundays CRM") exists as
# of 2026-09-24 but credentials are not configured here yet. Since
# Jan 2026 every new Shopify custom app uses the client-credentials grant
# (Client ID + Client Secret -> short-lived access token), not a static
# Admin API token — see docs/INTEGRATIONS.md and
# https://shopify.dev/docs/apps/build/dev-dashboard/get-api-access-tokens.
# SHOPIFY_STORE_DOMAIN must be the *.myshopify.com domain, not
# discosundays.com.
SHOPIFY_STORE_DOMAIN=discosundays.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2026-07
SHOPIFY_WEBHOOK_SECRET=

# ---- Base44 (Phase 8 — referral/rewards migration) ----
# Server-only.
BASE44_API_KEY=

# ---- App ----
NEXT_PUBLIC_APP_URL=https://crm.discosundays.com
